# Copy to .env.local if you want to change the defaults. Nothing here is required.
#
# API keys are NOT set here. Add them in the app at /settings. They are stored
# in the local SQLite database inside FOOTHOLD_DATA_DIR and only ever sent to
# the provider they belong to.

# Folder for the local SQLite database (default: ./data, which is gitignored).
FOOTHOLD_DATA_DIR=./data
